        <!-- ================= VIDEOS ================= -->
        <div id="page-videos" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-video" style="color:#ffc107;"></i> Video Manager</h3>
                    <button class="btn-add" onclick="openFileModal('video')"><i class="fas fa-plus"></i> Upload Video</button>
                </div>
                <div class="table-wrap">
