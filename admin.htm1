                    <h3><i class="fas fa-briefcase"></i> Jobs Manager</h3>
                    <button class="btn-add" onclick="openJobModal()"><i class="fas fa-plus"></i> Add Job</button>
                </div>
                <div class="table-wrap">
                    <table>
