                                <th>File Name</th>
                                <th>Category</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="photoTableBody">
                            <tr><td colspan="5" class="empty-state"><i class="fas fa-inbox"></i> No photos uploaded yet</td></tr>
