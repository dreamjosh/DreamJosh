        <!-- ================= QUIZ ================= -->
        <div id="page-quiz" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-brain"></i> Quiz Manager</h3>
                    <button class="btn-add" onclick="openQuizModal()"><i class="fas fa-plus"></i> Add Quiz</button>
                </div>
                <div class="table-wrap">
                    <table>
