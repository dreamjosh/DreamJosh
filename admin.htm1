        <!-- ================= PHOTOS ================= -->
        <div id="page-photos" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-images" style="color:#17a2b8;"></i> Photo Gallery</h3>
                    <button class="btn-add" onclick="openFileModal('photo')"><i class="fas fa-plus"></i> Upload Photo</button>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
