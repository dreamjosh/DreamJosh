        <!-- ================= FORMS ================= -->
        <div id="page-forms" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-list-check"></i> Important Forms Manager</h3>
                    <button class="btn-add" onclick="openFormModal()"><i class="fas fa-plus"></i> Add Form</button>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Link</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="formsTableBody">
                            <tr><td colspan="5" class="empty-state"><i class="fas fa-inbox"></i> No forms added yet</td></tr>
                        </tbody>
                    </table>
