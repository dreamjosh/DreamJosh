<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dream Josh - Professional Admin Panel v4.0</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ================= CSS VARIABLES ================= */
        :root {
            --primary: #123c9b;
            --primary-dark: #0d2d7a;
            --primary-light: #1976d2;
            --secondary: #1a2332;
            --success: #16a34a;
            --danger: #dc3545;
            --warning: #ffc107;
            --info: #17a2b8;
            --gold: #ffd700;
            --bg: #f0f2f5;
            --card-bg: #ffffff;
            --text: #172033;
            --text-light: #6c757d;
            --border: #e9ecef;
            --shadow: 0 2px 12px rgba(0,0,0,0.08);
            --radius: 12px;
            --transition: 0.3s ease;
        }

        .dark-mode {
            --bg: #0a0e1a;
            --card-bg: #141428;
            --text: #e8e8e8;
            --text-light: #a0a0b8;
            --border: #2a2a4a;
            --shadow: 0 2px 12px rgba(0,0,0,0.4);
            --secondary: #1a1a2e;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* ================= SIDEBAR ================= */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 270px;
            background: var(--secondary);
            color: #fff;
            padding: 20px 0;
            z-index: 1000;
            transition: transform 0.3s ease, background 0.3s ease;
            overflow-y: auto;
        }

        .sidebar .logo {
            padding: 0 20px 20px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar .logo h1 { font-size: 22px; font-weight: 700; color: #fff; }
        .sidebar .logo h1 span { color: var(--gold); }
        .sidebar .logo .badge {
            background: var(--success);
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 600;
        }

        .sidebar .user-info {
            padding: 0 20px 16px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .sidebar .user-info .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 600;
        }
        .sidebar .user-info .name { font-size: 14px; font-weight: 600; }
        .sidebar .user-info .role { font-size: 11px; opacity: 0.6; }

        .sidebar .menu {
            list-style: none;
            padding: 0 10px;
        }
        .sidebar .menu li { margin-bottom: 2px; }
        .sidebar .menu li a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 8px;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: 0.3s;
            cursor: pointer;
        }
        .sidebar .menu li a:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }
        .sidebar .menu li a.active {
            background: rgba(255,215,0,0.15);
            color: var(--gold);
        }
        .sidebar .menu li a i { width: 20px; font-size: 16px; }
        .sidebar .menu li a .count {
            margin-left: auto;
            background: rgba(255,255,255,0.1);
            padding: 1px 10px;
            border-radius: 20px;
            font-size: 11px;
        }
        .sidebar .menu .section-title {
            padding: 12px 14px 6px 14px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.4;
            font-weight: 700;
        }

        .sidebar .footer-menu {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px 10px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar .footer-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 8px;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: 0.3s;
            cursor: pointer;
        }
        .sidebar .footer-menu a:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }
        .sidebar .footer-menu a i { width: 20px; }

        /* ================= MAIN CONTENT ================= */
        .main-content {
            margin-left: 270px;
            padding: 24px 30px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        /* ================= TOP HEADER ================= */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
            gap: 12px;
        }
        .top-header .page-title h2 { font-size: 22px; font-weight: 700; }
        .top-header .page-title p { font-size: 13px; color: var(--text-light); margin-top: 2px; }

        .top-header .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .top-header .header-actions button {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .top-header .header-actions .btn-refresh {
            background: var(--success);
            color: #fff;
        }
        .top-header .header-actions .btn-refresh:hover { background: #15803d; }
        .top-header .header-actions .btn-dark {
            background: var(--secondary);
            color: #fff;
        }
        .top-header .header-actions .btn-dark:hover { opacity: 0.8; }
        .top-header .header-actions .btn-dark.active {
            background: var(--gold);
            color: #0a0e1a;
        }

        /* ================= STATS CARDS ================= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin: 20px 0;
        }
        .stat-card {
            background: var(--card-bg);
            padding: 18px 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: 0.3s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
        .stat-card .label { font-size: 12px; color: var(--text-light); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-card .value { font-size: 28px; font-weight: 700; color: var(--primary); margin-top: 4px; }
        .stat-card .icon { font-size: 24px; opacity: 0.3; float: right; }

        /* ================= SECTION CARDS ================= */
        .section-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            padding: 20px;
            margin: 16px 0;
            transition: 0.3s;
        }
        .section-card .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 16px;
        }
        .section-card .section-header h3 {
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-card .section-header .btn-add {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .section-card .section-header .btn-add:hover { background: var(--primary-dark); }

        .section-card .table-wrap {
            overflow-x: auto;
        }
        .section-card table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .section-card table th {
            text-align: left;
            padding: 10px 12px;
            background: var(--bg);
            color: var(--text-light);
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border);
        }
        .section-card table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
        }
        .section-card table tr:hover td { background: var(--bg); }

        .section-card table .actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .section-card table .actions button {
            padding: 4px 10px;
            border: none;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .section-card table .actions .btn-edit {
            background: var(--warning);
            color: #333;
        }
        .section-card table .actions .btn-edit:hover { background: #e0a800; }
        .section-card table .actions .btn-delete {
            background: var(--danger);
            color: #fff;
        }
        .section-card table .actions .btn-delete:hover { background: #a71d2a; }
        .section-card table .actions .btn-view {
            background: var(--info);
            color: #fff;
        }
        .section-card table .actions .btn-view:hover { background: #138496; }

        .empty-state {
            text-align: center;
            padding: 30px;
            color: var(--text-light);
            font-size: 14px;
        }
        .empty-state i { font-size: 40px; opacity: 0.2; margin-bottom: 10px; display: block; }

        /* ================= TOAST ================= */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .toast {
            padding: 12px 20px;
            border-radius: 10px;
            color: #fff;
            font-size: 13px;
            font-weight: 500;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            animation: slideIn 0.4s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 280px;
        }
        .toast.success { background: var(--success); }
        .toast.error { background: var(--danger); }
        .toast.info { background: var(--info); }
        .toast.warning { background: var(--warning); color: #333; }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* ================= MODAL ================= */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9998;
            backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .modal-overlay.active { display: flex; }

        .modal {
            background: var(--card-bg);
            border-radius: var(--radius);
            max-width: 700px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            animation: modalIn 0.3s ease;
            border: 1px solid var(--border);
        }
        @keyframes modalIn {
            from { transform: scale(0.95) translateY(20px); opacity: 0; }
            to { transform: scale(1) translateY(0); opacity: 1; }
        }

        .modal .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }
        .modal .modal-header h2 { font-size: 20px; }
        .modal .modal-header .close {
            font-size: 24px;
            cursor: pointer;
            opacity: 0.5;
            transition: 0.3s;
            background: none;
            border: none;
            color: var(--text);
        }
        .modal .modal-header .close:hover { opacity: 1; }

        .modal .form-group { margin-bottom: 14px; }
        .modal .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-light);
            margin-bottom: 4px;
        }
        .modal .form-group label .required { color: var(--danger); }
        .modal .form-group input,
        .modal .form-group select,
        .modal .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            background: var(--bg);
            color: var(--text);
            transition: 0.3s;
            font-family: inherit;
        }
        .modal .form-group input:focus,
        .modal .form-group select:focus,
        .modal .form-group textarea:focus {
            border-color: var(--primary);
            outline: none;
        }
        .modal .form-group textarea { min-height: 80px; resize: vertical; }
        .modal .form-group .file-input-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
            width: 100%;
        }
        .modal .form-group .file-input-wrapper input[type="file"] {
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }
        .modal .form-group .file-input-wrapper .file-label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            border: 2px dashed var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text-light);
            cursor: pointer;
            transition: 0.3s;
        }
        .modal .form-group .file-input-wrapper .file-label:hover {
            border-color: var(--primary);
            background: var(--card-hover);
        }
        .modal .form-group .file-input-wrapper .file-label i { font-size: 20px; }

        .modal .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        @media (max-width: 600px) {
            .modal .form-row { grid-template-columns: 1fr; }
        }

        .modal .btn-submit {
            padding: 10px 24px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .modal .btn-submit:hover { background: var(--primary-dark); }

        .modal .question-item {
            background: var(--bg);
            padding: 14px;
            border-radius: 8px;
            margin-bottom: 10px;
            border: 1px solid var(--border);
        }
        .modal .question-item input,
        .modal .question-item select {
            margin-bottom: 6px;
        }

        /* ================= SUB-SECTION MENU ================= */
        .sub-section-menu {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 16px;
            padding: 12px 16px;
            background: var(--bg);
            border-radius: var(--radius);
            border: 1px solid var(--border);
        }
        .sub-section-menu button {
            padding: 6px 14px;
            border: 2px solid var(--border);
            border-radius: 20px;
            background: var(--card-bg);
            color: var(--text);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .sub-section-menu button:hover {
            border-color: var(--primary);
            color: var(--primary);
        }
        .sub-section-menu button.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        /* ================= PREVIEW ================= */
        .file-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 8px;
        }
        .file-preview .preview-item {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .file-preview .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .file-preview .preview-item .file-icon {
            font-size: 30px;
            color: var(--text-light);
        }
        .file-preview .preview-item .remove-file {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--danger);
            color: #fff;
            border: none;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ================= RESPONSIVE ================= */
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
            }
            .sidebar.open { transform: translateX(0); }
            .main-content { margin-left: 0; padding: 16px; }

            .menu-toggle {
                display: flex !important;
            }

            .stats-grid { grid-template-columns: 1fr 1fr; }
        }

        .menu-toggle {
            display: none;
            background: var(--secondary);
            color: #fff;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 18px;
            cursor: pointer;
        }

        @media (max-width: 480px) {
            .stats-grid { grid-template-columns: 1fr; }
            .top-header .page-title h2 { font-size: 18px; }
            .modal { padding: 20px; }
        }

        /* ================= SCROLLBAR ================= */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: var(--primary-light); border-radius: 10px; }

        /* ================= CATEGORY BADGES ================= */
        .category-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        .category-badge.study { background: #1976d2; color: #fff; }
        .category-badge.career { background: #16a34a; color: #fff; }
        .category-badge.books { background: #ffc107; color: #333; }
        .category-badge.rajasthan { background: #dc3545; color: #fff; }
        .category-badge.quiz { background: #17a2b8; color: #fff; }
        .category-badge.more { background: #6c757d; color: #fff; }
        .category-badge.government { background: #123c9b; color: #fff; }
        .category-badge.general { background: #28a745; color: #fff; }
        .category-badge.pdf { background: #dc3545; color: #fff; }
        .category-badge.photo { background: #17a2b8; color: #fff; }
        .category-badge.video { background: #ffc107; color: #333; }

        /* ================= FILE TYPE ICONS ================= */
        .file-type-icon {
            font-size: 24px;
            margin-right: 8px;
        }
        .file-type-icon.pdf { color: #dc3545; }
        .file-type-icon.photo { color: #17a2b8; }
        .file-type-icon.video { color: #ffc107; }
        .file-type-icon.document { color: #1976d2; }

        /* ================= UPLOAD PROGRESS ================= */
        .upload-progress {
            width: 100%;
            height: 4px;
            background: var(--border);
            border-radius: 2px;
            margin-top: 6px;
            overflow: hidden;
        }
        .upload-progress .progress-bar {
            height: 100%;
            background: var(--success);
            border-radius: 2px;
            transition: width 0.3s ease;
            width: 0%;
        }
    </style>
</head>
<body>

    <!-- ================= SIDEBAR ================= -->
    <nav class="sidebar" id="sidebar">
        <div class="logo">
            <h1>🚀 <span>Dream</span>Josh</h1>
            <span class="badge">v4.0</span>
        </div>

        <div class="user-info">
            <div class="avatar">A</div>
            <div>
                <div class="name">Admin</div>
                <div class="role">Super Admin</div>
            </div>
        </div>

        <ul class="menu">
            <li class="section-title">Main</li>
            <li><a class="active" data-page="dashboard" onclick="showPage('dashboard')"><i class="fas fa-chart-pie"></i> Dashboard <span class="count">Live</span></a></li>
            
            <li class="section-title">Content Management</li>
            <li><a data-page="content" onclick="showPage('content')"><i class="fas fa-file-alt"></i> Content <span class="count" id="contentCount">0</span></a></li>
            <li><a data-page="subsections" onclick="showPage('subsections')"><i class="fas fa-sitemap"></i> Sub-Sections <span class="count" id="subSectionCount">0</span></a></li>
            
            <li class="section-title">Media Library</li>
            <li><a data-page="pdfs" onclick="showPage('pdfs')"><i class="fas fa-file-pdf"></i> PDFs <span class="count" id="pdfCount">0</span></a></li>
            <li><a data-page="photos" onclick="showPage('photos')"><i class="fas fa-images"></i> Photos <span class="count" id="photoCount">0</span></a></li>
            <li><a data-page="videos" onclick="showPage('videos')"><i class="fas fa-video"></i> Videos <span class="count" id="videoCount">0</span></a></li>
            
            <li class="section-title">Management</li>
            <li><a data-page="jobs" onclick="showPage('jobs')"><i class="fas fa-briefcase"></i> Jobs <span class="count" id="jobsCount">0</span></a></li>
            <li><a data-page="quiz" onclick="showPage('quiz')"><i class="fas fa-brain"></i> Quiz <span class="count" id="quizCount">0</span></a></li>
            <li><a data-page="forms" onclick="showPage('forms')"><i class="fas fa-list-check"></i> Forms <span class="count" id="formsCount">0</span></a></li>
            
            <li class="section-title">System</li>
            <li><a data-page="notifications" onclick="showPage('notifications')"><i class="fas fa-bell"></i> Notifications</a></li>
            <li><a data-page="settings" onclick="showPage('settings')"><i class="fas fa-cog"></i> Settings</a></li>
        </ul>

        <div class="footer-menu">
            <a onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="main-content" id="mainContent">
        
        <!-- ================= TOP HEADER ================= -->
        <div class="top-header">
            <div class="page-title">
                <h2 id="pageTitle">📊 Dashboard</h2>
                <p id="pageSubtitle">Overview of your website</p>
            </div>
            <div class="header-actions">
                <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <button class="btn-refresh" onclick="refreshData()"><i class="fas fa-sync-alt"></i> Refresh</button>
                <button class="btn-dark" id="darkToggle" onclick="toggleDarkMode()"><i class="fas fa-moon"></i> Dark</button>
                <button class="btn-refresh" style="background:#6c757d;" onclick="window.location.href='index.html'"><i class="fas fa-external-link-alt"></i> View Site</button>
            </div>
        </div>

        <!-- ================= DASHBOARD ================= -->
        <div id="page-dashboard">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-file-alt"></i></div>
                    <div class="label">Total Content</div>
                    <div class="value" id="statContent">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-sitemap"></i></div>
                    <div class="label">Sub-Sections</div>
                    <div class="value" id="statSubSections">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-file-pdf"></i></div>
                    <div class="label">PDFs</div>
                    <div class="value" id="statPdfs">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-images"></i></div>
                    <div class="label">Photos</div>
                    <div class="value" id="statPhotos">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-video"></i></div>
                    <div class="label">Videos</div>
                    <div class="value" id="statVideos">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-briefcase"></i></div>
                    <div class="label">Jobs</div>
                    <div class="value" id="statJobs">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-brain"></i></div>
                    <div class="label">Quizzes</div>
                    <div class="value" id="statQuiz">0</div>
                </div>
                <div class="stat-card">
                    <div class="icon"><i class="fas fa-list-check"></i></div>
                    <div class="label">Forms</div>
                    <div class="value" id="statForms">0</div>
                </div>
            </div>

            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-bolt" style="color:var(--gold);"></i> Quick Actions</h3>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:10px;">
                    <button class="btn-add" onclick="showPage('content'); openContentModal();"><i class="fas fa-plus"></i> Add Content</button>
                    <button class="btn-add" onclick="showPage('subsections'); openSubSectionModal();"><i class="fas fa-plus"></i> Add Sub-Section</button>
                    <button class="btn-add" onclick="showPage('pdfs'); openFileModal('pdf');"><i class="fas fa-plus"></i> Upload PDF</button>
                    <button class="btn-add" onclick="showPage('photos'); openFileModal('photo');"><i class="fas fa-plus"></i> Upload Photo</button>
                    <button class="btn-add" onclick="showPage('videos'); openFileModal('video');"><i class="fas fa-plus"></i> Upload Video</button>
                    <button class="btn-add" onclick="showPage('jobs'); openJobModal();"><i class="fas fa-plus"></i> Add Job</button>
                    <button class="btn-add" onclick="showPage('quiz'); openQuizModal();"><i class="fas fa-plus"></i> Add Quiz</button>
                    <button class="btn-add" onclick="showPage('forms'); openFormModal();"><i class="fas fa-plus"></i> Add Form</button>
                    <button class="btn-add" style="background:var(--success);" onclick="exportData()"><i class="fas fa-download"></i> Export Backup</button>
                </div>
            </div>
        </div>

        <!-- ================= CONTENT ================= -->
        <div id="page-content" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-file-alt"></i> Content Manager</h3>
                    <button class="btn-add" onclick="openContentModal()"><i class="fas fa-plus"></i> Add Content</button>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Sub-Section</th>
                                <th>Tags</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="contentTableBody">
                            <tr><td colspan="6" class="empty-state"><i class="fas fa-inbox"></i> No content added yet</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= SUB-SECTIONS ================= -->
        <div id="page-subsections" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-sitemap"></i> Sub-Sections Manager</h3>
                    <button class="btn-add" onclick="openSubSectionModal()"><i class="fas fa-plus"></i> Add Sub-Section</button>
                </div>
                <div class="sub-section-menu" id="subSectionMenu">
                    <button class="active" data-sub="all" onclick="filterBySubSection('all')">📂 All</button>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Parent Category</th>
                                <th>Icon</th>
                                <th>Items</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="subSectionTableBody">
                            <tr><td colspan="6" class="empty-state"><i class="fas fa-inbox"></i> No sub-sections added yet</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= PDFs ================= -->
        <div id="page-pdfs" style="display:none;">
            <div class="section-card">
                <div class="section-header">
                    <h3><i class="fas fa-file-pdf" style="color:#dc3545;"></i> PDF Manager</h3>
                    <button class="btn-add" onclick="openFileModal('pdf')"><i class="fas fa-plus"></i> Upload PDF</button>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>File Name</th>
                                <th>Category</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th>Actions</th>
                            </tr>
